<?xml version="1.0"?>
<package format="3">
  <name>flux_sim_viz</name>
  <version>0.1.0</version>
  <description>Simulation-only RViz view of the Flux Dex3 evaluation: G1 joint-state bridge, robot model and head camera.</description>
  <maintainer email="maintainer@example.invalid">FLUX Action maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
