   private:
+    void PublishStatus() {
+      const auto now = std::chrono::steady_clock::now();
+      if (last_status_publish_ != std::chrono::steady_clock::time_point{} &&
+          now - last_status_publish_ < std::chrono::milliseconds(100)) return;
+      last_status_publish_ = now;
+      std::string age = "null";
+      if (pose_interface_) {
+        if (auto valid = pose_interface_->GetLastValidTokenTime()) {
+          age = std::to_string(std::chrono::duration_cast<std::chrono::milliseconds>(now - *valid).count());
+        }
+      }
+      const std::string payload = "sonic_status {\"mode\":\"" +
+          std::string(active_mode_ == ManagedMode::PLANNER ? "PLANNER" : "STREAMED_MOTION") +
+          "\",\"valid_token_age_ms\":" + age +
+          ",\"sequence\":" + std::to_string(++status_sequence_) + "}";
+      try {
+        status_publisher_.send(zmq::buffer(payload), zmq::send_flags::dontwait);
+      } catch (const zmq::error_t& error) {
+        std::cerr << "[ZMQManager] status publish failed: " << error.what() << std::endl;
+      }
+    }
