#usda 1.0
(
    defaultPrim = "g1_29dof_with_hand_rev_1_0"
    metersPerUnit = 1
    upAxis = "Z"
)

# Appearance-only overlay over the pinned SONIC Dex3 G1 asset.
#
# The pinned USD binds 48 of its 49 visual meshes to one OmniPBR material whose
# albedo is (1,1,1) and which authors no metallic or roughness value, so both
# entry points (the dynamic simulator and the GRAIL replay) render a flat white
# robot. The source URDF marks seven links dark (0.2) and the other 42 white
# (0.7); the URDF -> USD conversion dropped that split. This layer restores the
# two-tone body of the real G1 - satin silver-grey shells over near-black
# polymer - following the albedo/metalness family NVIDIA's own G1 asset uses
# (0.45-0.55 albedo at high metalness).
#
# Values were picked from renders of both light rigs (the dynamic simulator's
# neutral dome and the replay's dim bluish dome): at full metalness the shell
# reflects those domes and reads far darker than the reference, so the shell
# keeps a slightly lighter albedo (0.55) at metallic 0.85.
#
# Nothing here authors geometry, joints, masses, collisions or any other
# physics property: only material inputs and twenty-two material bindings.
over "g1_29dof_with_hand_rev_1_0" (
    prepend references = @/data/models/sonic-assets/g1_29dof_with_hand_rev_1_0.usd@
)
{
    over "Looks"
    {
        # Body shells: the 42 links the source URDF declares white.
        over "material_DefaultMaterial"
        {
            over "Shader"
            {
                color3f inputs:diffuse_color_constant = (0.55, 0.55, 0.55)
                float inputs:metallic_constant = 0.85
                float inputs:reflection_roughness_constant = 0.3
            }
        }

        # Dark parts: the head shell and its visor, the pelvis, the hip and
        # ankle housings, the chest logo and the Dex3 hands. logo_link already
        # binds this material; the twenty-two links rebound below share it.
        over "material_DefaultMaterial_1"
        {
            over "Shader"
            {
                color3f inputs:diffuse_color_constant = (0.07, 0.07, 0.072)
                float inputs:metallic_constant = 0.3
                float inputs:reflection_roughness_constant = 0.4
            }
        }
    }

    # The source URDF gives these six links the `dark` material; the conversion
    # left them on the shell material.
    over "pelvis"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "head_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "left_hip_pitch_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "right_hip_pitch_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "left_ankle_roll_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "right_ankle_roll_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    # The Dex3 hands are black on the real robot; the source URDF calls them
    # white, so the conversion left them on the shell material.
    over "left_hand_palm_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "left_hand_index_0_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

