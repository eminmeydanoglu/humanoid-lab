        }
    }

    over "right_hand_index_0_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </g1_29dof_with_hand_rev_1_0/Looks/material_DefaultMaterial_1>
        }
    }

    over "right_hand_index_1_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
