# setup.sh .env'i buradan uretir; mevcut .env asla uzerine yazilmaz. Secret yok.

COMPOSE_PROJECT_NAME=humanoid-lab

# tum kalici veri dizinleri
HUMANOID_DATA_ROOT=/home/USER/humanoid-lab-data

# git working tree (bind mount)
HUMANOID_SOURCE_ROOT=/home/USER/code/humanoid-lab

# robot agi / DDS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# N -> image build/start durur
ACCEPT_EULA=Y

# NVIDIA telemetry (N=off)
PRIVACY_CONSENT=N

# sadece GUI gerekiyorsa
DISPLAY=:0

# HF token .env'e yazilmaz -> ./dev.sh hf-login
