# Copied to .env by ./setup.sh; an existing .env is never overwritten. No secrets here.

# Prefix for compose project and container/network names.
COMPOSE_PROJECT_NAME=humanoid-lab

# Host root for all persistent data dirs. setup.sh creates them.
HUMANOID_DATA_ROOT=/home/USER/humanoid-lab-data

# Project source root (git working tree). Bind-mounted.
HUMANOID_SOURCE_ROOT=/home/USER/code/humanoid-lab

# ROS 2 / DDS settings — used when talking to the robot network (see ros/README.md).
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Isaac Sim EULA acceptance; N stops image build/start.
ACCEPT_EULA=Y

# NVIDIA telemetry: N = off (default), Y = on.
PRIVACY_CONSENT=N

# X11 (only if GUI needed; headless validation is independent of GUI).
DISPLAY=:0

# HF_HOME always points to /cache/huggingface inside the container (host bind mount).
# Token is never written to .env or the image; ./dev.sh hf-login handles it.