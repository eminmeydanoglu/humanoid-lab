# setup.sh .env'i buradan uretir; mevcut .env asla uzerine yazilmaz. Secret yok.

COMPOSE_PROJECT_NAME=humanoid-lab

# tum kalici veri dizinleri
HUMANOID_DATA_ROOT=/home/USER/code/humanoid-lab/data

# git working tree (bind mount)
HUMANOID_SOURCE_ROOT=/home/USER/code/humanoid-lab

# DDS: development/simulation default. Physical-robot access is a separate,
# explicitly configured direct-DDS workflow; do not reuse its domain here.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///opt/humanoid-lab/cyclonedds-sim.xml

# N -> image build/start durur
ACCEPT_EULA=Y

# NVIDIA telemetry (N=off)
PRIVACY_CONSENT=N

# sadece GUI gerekiyorsa
DISPLAY=:0

# F310/joystick icin: setup.sh host 'input' grubunun numeric GID'ini buraya
# yazar (HOST_INPUT_GID). Anahtar yoksa compose baslamaz.

# HF token .env'e yazilmaz -> ./dev.sh hf-login
